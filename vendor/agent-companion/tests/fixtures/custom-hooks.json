{
  "note": "Shared fixtures for the custom-agent-hooks contract. The Rust core (crates/agent-studio-core/src/custom) and the Node collector (collector/lib/custom.js) must agree on every entry here; scripts/qa-custom-parity.mjs deep-compares their normalized output.",
  "limits": {
    "templateBytes": 1048576,
    "payloadBytes": 1048576,
    "nameMax": 120,
    "pointerMax": 512,
    "eventsMax": 64,
    "eventNameMax": 200,
    "ignoreIfPresentMax": 16,
    "sessionIdMax": 256,
    "idFieldMax": 256,
    "eventIdMax": 200,
    "cwdMax": 2048,
    "titleMax": 4096,
    "dedupPerSession": 64,
    "sessionsMax": 256,
    "diagnosticsMax": 50
  },
  "base": {
    "schemaVersion": 1,
    "id": "example-agent",
    "name": "Example Agent",
    "transport": "hook",
    "mapping": {
      "event": "/event_name",
      "sessionId": "/session_id",
      "roundId": "/round_id",
      "eventId": "/event_id",
      "timestamp": "/ts",
      "cwd": "/cwd",
      "title": "/prompt",
      "requestId": "/request_id"
    },
    "ignoreIfPresent": ["/parent_session_id"],
    "events": {
      "prompt_submitted": {"action": "start"},
      "permission_requested": {"action": "wait", "reason": "permission"},
      "input_requested": {"action": "wait", "reason": "input"},
      "execution_resumed": {"action": "resume"},
      "response_finished": {"action": "finish", "status": "done"},
      "response_failed": {"action": "finish", "status": "error"},
      "session_closed": {"action": "close"}
    }
  },
  "templates": {
    "example": {
      "schemaVersion": 1,
      "id": "example-agent",
      "name": "Example Agent",
      "transport": "hook",
      "mapping": {
        "event": "/event_name",
        "sessionId": "/session_id",
        "roundId": "/round_id",
        "eventId": "/event_id",
        "timestamp": "/ts",
        "cwd": "/cwd",
        "title": "/prompt",
        "requestId": "/request_id"
      },
      "ignoreIfPresent": ["/parent_session_id"],
      "events": {
        "prompt_submitted": {"action": "start"},
        "permission_requested": {"action": "wait", "reason": "permission"},
        "input_requested": {"action": "wait", "reason": "input"},
        "execution_resumed": {"action": "resume"},
        "response_finished": {"action": "finish", "status": "done"},
        "response_failed": {"action": "finish", "status": "error"},
        "session_closed": {"action": "close"}
      }
    },
    "minimal": {
      "schemaVersion": 1,
      "id": "minimal-agent",
      "name": "Minimal Agent",
      "transport": "hook",
      "mapping": {"event": "/kind", "sessionId": "/sid"},
      "events": {
        "begin": {"action": "start"},
        "end": {"action": "finish", "status": "done"}
      }
    }
  },
  "invalid": [
    {"name": "schema-version", "path": "/schemaVersion", "mutate": [{"op": "set", "pointer": "/schemaVersion", "value": 2}]},
    {"name": "schema-version-missing", "path": "/schemaVersion", "mutate": [{"op": "remove", "pointer": "/schemaVersion"}]},
    {"name": "id-uppercase", "path": "/id", "mutate": [{"op": "set", "pointer": "/id", "value": "Example-Agent"}]},
    {"name": "id-builtin", "path": "/id", "mutate": [{"op": "set", "pointer": "/id", "value": "codex"}]},
    {"name": "id-builtin-dash", "path": "/id", "mutate": [{"op": "set", "pointer": "/id", "value": "codebuddy-ide"}]},
    {"name": "id-empty", "path": "/id", "mutate": [{"op": "set", "pointer": "/id", "value": ""}]},
    {"name": "id-too-long", "path": "/id", "mutate": [{"op": "set", "pointer": "/id", "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]},
    {"name": "id-not-string", "path": "/id", "mutate": [{"op": "set", "pointer": "/id", "value": 7}]},
    {"name": "name-missing", "path": "/name", "mutate": [{"op": "remove", "pointer": "/name"}]},
    {"name": "name-empty", "path": "/name", "mutate": [{"op": "set", "pointer": "/name", "value": ""}]},
    {"name": "transport-invalid", "path": "/transport", "mutate": [{"op": "set", "pointer": "/transport", "value": "http"}]},
    {"name": "transport-missing", "path": "/transport", "mutate": [{"op": "remove", "pointer": "/transport"}]},
    {"name": "unknown-top-key", "path": "/extra", "mutate": [{"op": "set", "pointer": "/extra", "value": true}]},
    {"name": "mapping-missing", "path": "/mapping", "mutate": [{"op": "remove", "pointer": "/mapping"}]},
    {"name": "mapping-event-missing", "path": "/mapping/event", "mutate": [{"op": "remove", "pointer": "/mapping/event"}]},
    {"name": "mapping-event-not-pointer", "path": "/mapping/event", "mutate": [{"op": "set", "pointer": "/mapping/event", "value": "event_name"}]},
    {"name": "mapping-session-missing", "path": "/mapping/sessionId", "mutate": [{"op": "remove", "pointer": "/mapping/sessionId"}]},
    {"name": "mapping-session-not-pointer", "path": "/mapping/sessionId", "mutate": [{"op": "set", "pointer": "/mapping/sessionId", "value": "/"}]},
    {"name": "mapping-unknown-key", "path": "/mapping/session_id", "mutate": [{"op": "set", "pointer": "/mapping/session_id", "value": "/sid"}]},
    {"name": "pointer-bad-escape", "path": "/mapping/event", "mutate": [{"op": "set", "pointer": "/mapping/event", "value": "/bad~2escape"}]},
    {"name": "pointer-too-long", "path": "/mapping/event", "mutate": [{"op": "set", "pointer": "/mapping/event", "value": ""}]},
    {"name": "events-missing", "path": "/events", "mutate": [{"op": "remove", "pointer": "/events"}]},
    {"name": "events-empty", "path": "/events", "mutate": [{"op": "set", "pointer": "/events", "value": {}}]},
    {"name": "events-unknown-action", "path": "/events/prompt_submitted/action", "mutate": [{"op": "set", "pointer": "/events/prompt_submitted/action", "value": "pause"}]},
    {"name": "events-action-missing", "path": "/events/prompt_submitted/action", "mutate": [{"op": "remove", "pointer": "/events/prompt_submitted/action"}]},
    {"name": "events-not-object", "path": "/events/prompt_submitted", "mutate": [{"op": "set", "pointer": "/events/prompt_submitted", "value": "start"}]},
    {"name": "wait-missing-reason", "path": "/events/permission_requested/reason", "mutate": [{"op": "remove", "pointer": "/events/permission_requested/reason"}]},
    {"name": "wait-bad-reason", "path": "/events/permission_requested/reason", "mutate": [{"op": "set", "pointer": "/events/permission_requested/reason", "value": "timeout"}]},
    {"name": "wait-extra-key", "path": "/events/permission_requested/status", "mutate": [{"op": "set", "pointer": "/events/permission_requested/status", "value": "done"}]},
    {"name": "finish-missing-status", "path": "/events/response_finished/status", "mutate": [{"op": "remove", "pointer": "/events/response_finished/status"}]},
    {"name": "finish-bad-status", "path": "/events/response_finished/status", "mutate": [{"op": "set", "pointer": "/events/response_finished/status", "value": "ok"}]},
    {"name": "start-extra-key", "path": "/events/prompt_submitted/reason", "mutate": [{"op": "set", "pointer": "/events/prompt_submitted/reason", "value": "permission"}]},
    {"name": "ignore-not-array", "path": "/ignoreIfPresent", "mutate": [{"op": "set", "pointer": "/ignoreIfPresent", "value": "/parent_session_id"}]},
    {"name": "ignore-bad-pointer", "path": "/ignoreIfPresent/0", "mutate": [{"op": "set", "pointer": "/ignoreIfPresent/0", "value": "parent_session_id"}]},
    {"name": "ignore-item-not-string", "path": "/ignoreIfPresent/0", "mutate": [{"op": "set", "pointer": "/ignoreIfPresent/0", "value": 3}]}
  ],
