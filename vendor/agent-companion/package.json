{
  "name": "agent-companion",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "npm run desktop:dev",
    "build": "vite build",
    "build:embed": "vite build --base ./ --outDir dist-embed",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1 --port 4189",
    "test": "node --import tsx --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "ci:web": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:bundle",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:web": "vite --host 127.0.0.1 --port 4189 --strictPort",
    "demo:dev": "vite --mode demo --host 127.0.0.1 --port 4190 --strictPort",
    "desktop:dev": "npm run desktop:prepare && tauri dev",
    "desktop:build": "tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "test:rust": "cargo test --workspace --locked && node scripts/qa-rust-parity.mjs",
    "test:runtime": "npm run desktop:prepare && node scripts/qa-native-runtime.mjs",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:ui": "node scripts/qa-ui.mjs",
    "test:demo": "node scripts/qa-demo.mjs",
    "test:native-app": "npm run desktop:build -- --features diagnostics && node scripts/qa-native-app.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "1.58.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
